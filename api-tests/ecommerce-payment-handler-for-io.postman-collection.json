					"raw": "{\n    \"userTouchpoint\": \"IO\",\n    \"userDevice\": \"IOS\",\n    \"totalAmount\": 15050,\n    \"language\": \"IT\",\n    \"sortBy\": \"DESCRIPTION\",\n    \"sortOrder\": \"ASC\",\n    \"priorityGroups\": [\"CP\"],\n    \"paymentNotice\": [\n        {\n            \"paymentAmount\": 15050,\n            \"primaryCreditorInstitution\": \"PA_FISCAL_CODE_1\",\n            \"transferList\": [\n                {\n                    \"creditorInstitution\": \"PA_FISCAL_CODE_1\",\n                    \"transferCategory\": \"TAX\",\n                    \"digitalStamp\": false\n                }\n            ]\n        }\n    ],\n    \"allCCp\": false\n }",
					"options": {
						"raw": {
							"language": "json"
